# Configure these as server environment variables. Do not upload a real .env publicly.
PMAS_ENV=production
PMAS_APP_URL=https://pmas.example.com
PMAS_BASE_PATH=/
# Preferred on Vercel: paste the external MySQL provider's connection URL.
# Use mysql:// (not postgres://). Percent-encode special characters in credentials.
PMAS_DATABASE_URL=mysql://user:password@host:3306/database_name
# Alternatively, omit PMAS_DATABASE_URL and configure all PMAS_DB_* values below.
PMAS_DB_HOST=private-mysql-host
PMAS_DB_PORT=3306
PMAS_DB_NAME=hosting_database_name
PMAS_DB_USER=hosting_database_user
PMAS_DB_PASS=replace-with-a-strong-password
# Optional path when the provider requires a custom CA certificate.
PMAS_DB_SSL_CA=
PMAS_DATA_KEY=replace-with-the-existing-data-encryption-key
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=APPRAISIA
GEMINI_API_KEY=replace-with-a-new-rotated-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Vite overrides (normally placed in an untracked .env.local, not production).
# VITE_DEV_PHP_ORIGIN=http://localhost
# VITE_DEV_PHP_BASE_PATH=PMAS
# VITE_DEV_HTTPS=true
# VITE_DEV_SSL_CERT=C:/Users/you/.pmas-certs/localhost.pem
# VITE_DEV_SSL_KEY=C:/Users/you/.pmas-certs/localhost-key.pem

# Optional only when PHP redirects must target a different frontend origin.
# PMAS_REACT_URL=https://pmas.example.com
