function dipascaf_ensure_form_b_schema(): void
{
    static $checked = false;

    if ($checked) {
        return;
    

    $checked = true;

    }
    try {
        db()->exec(
            'CREATE TABLE IF NOT EXISTS pmas_form_b_categories (
                id INT AUTO_INCREMENT PRIMARY KEY,
                title VARCHAR(220) NOT NULL UNIQUE,
                factor_weight DECIMAL(5,2) NOT NULL,
                sort_order INT NOT NULL DEFAULT 0,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )'
        );

        db()->exec(
            'CREATE TABLE IF NOT EXISTS pmas_form_b_questions (
                id INT AUTO_INCREMENT PRIMARY KEY,
                category_id INT NOT NULL,
                question_text TEXT NOT NULL,
                sort_order INT NOT NULL DEFAULT 0,
                is_active TINYINT(1) NOT NULL DEFAULT 1,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE KEY uq_form_b_question (category_id, question_text(180)),
                CONSTRAINT fk_form_b_question_category
                    FOREIGN KEY (category_id) REFERENCES pmas_form_b_categories(id)
                    ON DELETE CASCADE
            )'
        );

        db()->exec(
            'CREATE TABLE IF NOT EXISTS pmas_form_b_category_results (
                id INT AUTO_INCREMENT PRIMARY KEY,
                assignment_id INT NOT NULL,
                evaluator_user_id INT NOT NULL,
                evaluatee_faculty_id INT NOT NULL,
                category_id INT NOT NULL,
                total_rate DECIMAL(6,2) NOT NULL,
                question_count INT NOT NULL,
                average_rating DECIMAL(4,2) NOT NULL,
                factor_weight DECIMAL(5,2) NOT NULL,
                weighted_score DECIMAL(6,4) NOT NULL,
                questionnaire_answers JSON NULL,
                behavioral_evidence TEXT NULL,
                reason_for_rating TEXT NULL,
                recommendation TEXT NULL,
                ai_suggestion TEXT NULL,
                ai_decision ENUM("none", "pending_review", "accepted", "edited", "rejected") NOT NULL DEFAULT "none",
                required_explanation ENUM("behavioral_evidence", "reason_for_rating", "behavioral_evidence_recommendation") NOT NULL DEFAULT "reason_for_rating",
                explanation_complete TINYINT(1) NOT NULL DEFAULT 0,
                evaluation_period VARCHAR(120) NOT NULL,
                status ENUM("draft", "completed") NOT NULL DEFAULT "completed",
                submitted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE KEY uq_form_b_assignment_category (assignment_id, category_id),
                CONSTRAINT fk_form_b_result_assignment
                    FOREIGN KEY (assignment_id) REFERENCES peer_assignments(id)
                    ON DELETE CASCADE,
                CONSTRAINT fk_form_b_result_evaluator
                    FOREIGN KEY (evaluator_user_id) REFERENCES users(id)
                    ON DELETE CASCADE,
                CONSTRAINT fk_form_b_result_faculty
                    FOREIGN KEY (evaluatee_faculty_id) REFERENCES faculty(id)
                    ON DELETE CASCADE,
                CONSTRAINT fk_form_b_result_category
                    FOREIGN KEY (category_id) REFERENCES pmas_form_b_categories(id)
                    ON DELETE CASCADE
            )'
        );

        foreach ([
            'ALTER TABLE pmas_form_b_categories ADD COLUMN description TEXT NULL AFTER title',
            'ALTER TABLE pmas_form_b_categories ADD COLUMN is_active TINYINT(1) NOT NULL DEFAULT 1 AFTER sort_order',
            'ALTER TABLE pmas_form_b_category_results MODIFY ai_decision ENUM("none", "pending_review", "accepted", "edited", "rejected") NOT NULL DEFAULT "none"',
            'ALTER TABLE pmas_form_b_category_results ADD COLUMN required_explanation ENUM("behavioral_evidence", "reason_for_rating", "behavioral_evidence_recommendation") NOT NULL DEFAULT "reason_for_rating" AFTER ai_decision',
            'ALTER TABLE pmas_form_b_category_results ADD COLUMN explanation_complete TINYINT(1) NOT NULL DEFAULT 0 AFTER required_explanation',
            'ALTER TABLE pmas_form_b_category_results ADD COLUMN questionnaire_evidence JSON NULL AFTER questionnaire_answers',
        ] as $sql) {
            try {
                db()->exec($sql);
             }
             catch (Throwable) {
             }
                // Existing databases may already have the column or enum definition.
            
        

        }
        foreach (dipascaf_form_b_seed() as $index => $category) {
            db()->prepare(
                'INSERT INTO pmas_form_b_categories (title, description, factor_weight, sort_order)
                 VALUES (:title, :description, :factor_weight, :sort_order)
                 ON DUPLICATE KEY UPDATE title = title'
            )->execute([
                'title' => $category['title'],
                'description' => $category['description'] ?? null,
                'factor_weight' => $category['factor_weight'],
                'sort_order' => $index + 1,
            ]);

            $categoryRow = admin_one('SELECT id FROM pmas_form_b_categories WHERE title = :title', ['title' => $category['title']]);
            if ($categoryRow === null) {
                continue;
            

            }
            foreach ($category['questions'] as $questionIndex => $questionText) {
                db()->prepare(
                    'INSERT INTO pmas_form_b_questions (category_id, question_text, sort_order, is_active)
                     VALUES (:category_id, :question_text, :sort_order, 1)
                     ON DUPLICATE KEY UPDATE question_text = question_text'
                )->execute([
                    'category_id' => (int) $categoryRow['id'],
                    'question_text' => $questionText,
                    'sort_order' => $questionIndex + 1,
                ]);
            
        
     }
        }
     catch (Throwable) {
     }
        // Database unavailable — skip Form B schema setup gracefully
    


/* ============================================================
 * PMAS Form A — Administrative Evaluation (Dean & Program Head)
 * ============================================================ */

    }
}
     }
            }
            }
        }
             }
            }
        }
    }
    }
}
