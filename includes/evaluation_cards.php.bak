            }
            ;

            window.closeDipascafEvaluation = function () {
                saveCurrentDraft();
                if (modal) modal.hidden = true;
            }
            ;

            document.querySelectorAll('.dipascaf-eval-menu button').forEach((button) => {
                button.addEventListener('click', () => {
                    document.querySelectorAll('.dipascaf-eval-menu button').forEach((item) => item.classList.remove('active'));
                    button.classList.add('active');
                    currentSection = button.dataset.section || 'all';
                    applyFilters();
                }
                );
            }
            }
            );

            shell?.querySelectorAll('[data-eval-search], [data-eval-role], [data-eval-department], [data-eval-status]').forEach((control) => {
                control.addEventListener('input', applyFilters);
            }
            );

            form?.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (currentUsesFormB) {
                    const completed = formBCategories.filter(isFormBCategoryComplete).length;
                    if (completed !== formBCategories.length || formBCategories.length === 0) {
                        errorBox.textContent = 'Complete all PMAS Form B categories and required explanation fields before submitting.';
                        errorBox.hidden = false;
                        return;
                    
                    updateFormBPayload();
                 }
                 else
                 }
                    const allComplete = formACategories.length > 0 && formACategories.every(isFormACategoryComplete);
                    if (!allComplete) {
                        errorBox.textContent = 'Complete all PMAS Form A categories and required explanation fields before submitting.';
                        errorBox.hidden = false;
                        return;
                    
                    updateFormAPayload();
                

                submitBtn.disabled = true;
                    }
                try {
                    const response = await fetch(window.location.href, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' 
                        }
                    }
                    );
                    const payload = await response.json();
                    if (!payload.success) throw new Error(payload.error || 'Unable to submit evaluation.');
                    if (currentAssignmentId) window.localStorage.removeItem(draftKey(currentAssignmentId, currentUsesFormB));
                    window.location.reload();
                 }
                 catch (error) {
                 }
                    errorBox.textContent = error.message;
                    errorBox.hidden = false;
                 finally {
                    submitBtn.disabled = false;
                
                 }
            }
            );

            applyFilters();
                 }
                 }
                        }
                    }
                }
                    }
                    }
                }
            }
            }
                }
            }
        }
            }
        }
        )();
    </script>
    <?php


}
