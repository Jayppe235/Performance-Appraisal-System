{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/uploads/:path*",
      "destination": "https://pmas-api-production.up.railway.app/assets/uploads/:path*"
    },
    {
      "source": "/api/:endpoint",
      "destination": "https://pmas-api-production.up.railway.app/api/:endpoint"
    },
    {
      "source": "/reports/:endpoint",
      "destination": "https://pmas-api-production.up.railway.app/api/vercel.php?_scope=reports&_endpoint=:endpoint"
    },
    {
      "source": "/((?!api/|reports/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
