# Optional local overrides. XAMPP defaults already match these values.
PMAS_ENV=local
PMAS_APP_URL=http://localhost/PMAS
PMAS_BASE_PATH=/PMAS
PMAS_DB_HOST=127.0.0.1
PMAS_DB_PORT=3306
PMAS_DB_NAME=pmas_db_clean
PMAS_DB_USER=root
PMAS_DB_PASS=

# Set this once and keep it unchanged if encrypted local data will be migrated.
PMAS_DATA_KEY=replace-with-at-least-32-random-characters
